rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidDateString(value) {
      return value is string && value.size() == 10 && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'defaultCycleLength', 'defaultPeriodDuration', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'defaultCycleLength', 'defaultPeriodDuration', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.defaultCycleLength is int
        && data.defaultCycleLength >= 15
        && data.defaultCycleLength <= 60
        && data.defaultPeriodDuration is int
        && data.defaultPeriodDuration >= 1
        && data.defaultPeriodDuration <= 15
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPeriodLog(data) {
      return data.keys().hasAll(['user_id', 'start_date', 'end_date', 'created_at', 'updated_at'])
        && data.keys().hasOnly(['user_id', 'start_date', 'end_date', 'created_at', 'updated_at'])
        && data.user_id is string
        && data.user_id == request.auth.uid
        && data.user_id.size() >= 1
        && data.user_id.size() <= 128
        && isValidDateString(data.start_date)
        && (data.end_date == null || (isValidDateString(data.end_date) && data.end_date >= data.start_date))
        && data.created_at is timestamp
        && data.updated_at is timestamp;
    }

    // --- Collections ---
    match /users/{userId} {
      allow get: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId;

      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['defaultCycleLength', 'defaultPeriodDuration', 'email', 'updatedAt'])
        );

      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId;
    }

    match /period_logs/{logId} {
      allow get: if isVerifiedUser()
        && isValidId(logId)
        && existing().user_id == request.auth.uid;

      allow list: if isVerifiedUser()
        && existing().user_id == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(logId)
        && isValidPeriodLog(incoming())
        && incoming().created_at == request.time
        && incoming().updated_at == request.time;

      allow update: if isVerifiedUser()
        && isValidId(logId)
        && existing().user_id == request.auth.uid
        && isValidPeriodLog(incoming())
        && incoming().user_id == existing().user_id
        && incoming().created_at == existing().created_at
        && incoming().updated_at == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['start_date', 'end_date', 'updated_at'])
        );

      allow delete: if isVerifiedUser()
        && isValidId(logId)
        && existing().user_id == request.auth.uid;
    }
  }
}
